---
/**
 * The top strip: the crumb on the left, the theme control and the source link
 * on the right. Sticky, 46px. The stdout block's header bar sticks directly
 * below it.
 *
 * The theme control cycles system → light → dark. Its label is written by CSS
 * from the `data-theme` stamp, not by script, so it is right in the first
 * painted frame. Verdict 4.
 *
 * The source link is the site's only door to this repo — the locked design has
 * no footer and no page links the source. It sits here because the strip is
 * sticky at every width, and it extends a control cluster that already exists.
 * Decided in wayfinder ticket #63, built in ticket #69. The locked design shows
 * the theme control alone and is deliberately NOT amended, so #63 is the
 * record.
 */
interface Props {
  /** The group heading, or an empty string for an ungrouped station. */
  group: string;
  /** The station label. It is the bold part of the crumb. */
  label: string;
}

const { group, label } = Astro.props;

/**
 * The source link's target: the repo root, from every page, with no per-page
 * variation.
 *
 * A skill page shows the CLI's *render*, not its source, and that distinction
 * is the product — so a link that jumped to `content/skills/<id>.md` on exactly
 * those pages was rejected. A constant target also means the reader learns the
 * control once. Ticket #63.
 */
const REPO = 'https://github.com/will-ness-ai/wayfinder-cli';
---

<div class="strip">
  <span class="crumb">{group && <>{group} / </>}<b>{label}</b></span>

  <button id="theme-toggle" type="button" aria-label="Change the colour theme">
    theme: <span class="theme-name"></span>
  </button>

  {/* The name is on the link, not on the icon, so a screen reader announces the
      destination rather than "link". The `theme:` control beside it carries the
      same kind of label. `title` gives a mouse user the same name on hover,
      which an icon with no text needs. */}
  <a class="source" href={REPO} aria-label="wayfinder-cli on GitHub" title="wayfinder-cli on GitHub">
    {/* GitHub's own mark, `mark-github-16` from the MIT-licensed Octicons set.
        Inline, because the site builds to a static Pages artifact: no remote
        asset, and no icon font. Its size is in src/styles/site.css with the
        rest of the design. */}
    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
      <path
        d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27s-1.36.09-2 .27c-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
      ></path>
    </svg>
  </a>
</div>

<script>
  // The head script has already stamped the root. This only cycles it.
  const ORDER = ['system', 'light', 'dark'] as const;
  const KEY = 'wayfinder-theme';
  const root = document.documentElement;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const now = root.getAttribute('data-theme') ?? 'system';
    const next = ORDER[(ORDER.indexOf(now as (typeof ORDER)[number]) + 1) % ORDER.length]!;

    if (next === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', next);

    // A browser with storage blocked still toggles; the choice just does not
    // survive the next page.
    try {
      if (next === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {
      /* no storage — nothing to do */
    }
  });
</script>
