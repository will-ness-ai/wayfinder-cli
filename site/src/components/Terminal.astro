---
/**
 * The third column: a terminal showing the output of the commands the prose
 * describes. It is what makes this site different from a generic docs theme —
 * the product is a program that prints things, so the site shows what it
 * prints, on every page. Verdict 1.
 *
 * The example is static: it does not follow the reader's scroll (verdict 6),
 * and the palette stays dark in both themes.
 *
 * The lines come from a copy file's `terminal` key. Every `out` and `ok` line
 * there was captured from the built CLI.
 */
import type { CollectionEntry } from 'astro:content';

type Terminal = CollectionEntry<'copy'>['data']['terminal'];

interface Props {
  terminal: Terminal;
}

const { terminal } = Astro.props;

/** `out` is plain terminal foreground, so it takes no class. */
const CLASS = { cmd: 'cmd', ok: 'ok', cm: 'cm', out: '' } as const;
---

<div class="term">
  <div class="bar"><span class="dot"></span>{terminal.label}</div>
  {/* One span per line, each followed by its own newline. `.term .out` sets
      `white-space: pre-wrap`, so the newlines are the line breaks and an empty
      line is a bare newline. The expression escapes the text for us. */}
  <div class="out">{
      terminal.lines.map(({ kind, text }) =>
        text === '' ? '\n' : [<span class={CLASS[kind]}>{text}</span>, '\n'],
      )
    }</div>
</div>
