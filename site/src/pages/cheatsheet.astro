---
/**
 * The cheatsheet, from src/copy/cheatsheet.md.
 *
 * One dense table, three columns, a rule and extra space to open each group.
 * Cards were prototyped and rejected: the page exists to be scanned, and card
 * borders spend space that rows want. Verdict 9.
 */
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { plain } from '../lib/text';

const entry = (await getEntry('copy', 'cheatsheet'))!;
const { groups, terminal, title, description } = entry.data;
const { Content } = await render(entry);

if (!groups) throw new Error('src/copy/cheatsheet.md must carry groups.');
---

<Page current="cheatsheet" title={title} description={description} terminal={terminal}>
  {/* The Markdown body is the standfirst — one paragraph, which `.pagehead p`
      styles. */}
  <div class="pagehead">
    <h1>{title}</h1>
    <Content />
  </div>

  <div class="tablewrap">
    <table class="cheattable">
      <thead>
        <tr><th>Group</th><th>Item</th><th>Meaning</th></tr>
      </thead>
      <tbody>
        {
          groups.flatMap((group) =>
            group.rows.map((row, n) => (
              <tr class:list={[{ first: n === 0 }]}>
                <td class="g">{n === 0 ? group.title : ''}</td>
                <td class="k">{plain(row.item)}</td>
                <td class="d">{plain(row.meaning)}</td>
              </tr>
            )),
          )
        }
      </tbody>
    </table>
  </div>
</Page>
