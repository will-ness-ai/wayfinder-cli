---
/**
 * The landing page. Verdict 8 in docs/prototypes/docs-site/README.md.
 *
 * The second panel takes the accent border and tint, so the eye sees that half
 * of the pitch is about extension, not complaint.
 */
import Page from '../layouts/Page.astro';
import { HERO, INSTALL, HALVES, UPSTREAM } from '../data/landing';
---

<Page
  current="overview"
  title="wayfinder-cli"
  description="A content-server CLI that renders planning skills as markdown for coding agents to read. Composed for your harness, substituted for your issue tracker, extended with the skills your team registered."
>
  <div class="hero">
    <h1>{HERO.headline}</h1>
    <p class="sub">{HERO.sub}</p>

    <div class="installblock">{
        INSTALL.map((command, n) => (
          <>
            <span class="p">$</span>{' '}
            <span class="c">{command}</span>
            {n < INSTALL.length - 1 ? '\n' : ''}
          </>
        ))
      }</div>

    <div class="split2">
      {
        HALVES.map((half) => (
          <div class:list={['panel', { add: half.index === '02' }]}>
            <div class="hh">
              <span class="ix">{half.index}</span>
              <b>{half.title}</b>
              <span class="nt">{half.note}</span>
            </div>
            {half.rows.map((row) => (
              <div class="it">
                <h4>{row.heading}</h4>
                <p>{row.body}</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <p class="outlink">
      New to wayfinding? This site documents the CLI, not the method — start at <a
        href={UPSTREAM}>aihero.dev/skills-wayfinder</a
      >.
    </p>
  </div>
</Page>
