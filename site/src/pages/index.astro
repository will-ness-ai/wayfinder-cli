---
/**
 * The landing page, from src/copy/overview.md.
 *
 * One oversized statement, the install commands in a dark block, then the
 * pitch split 50/50 into two bordered panels. The second panel takes the
 * accent border and tint, so the eye sees that half of the pitch is about
 * extension, not complaint. Verdict 8.
 */
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

const { data } = (await getEntry('copy', 'overview'))!;
const { hero, install, panels, upstream, terminal } = data;

if (!hero || !install || !panels || !upstream) {
  throw new Error('src/copy/overview.md must carry hero, install, panels, and upstream.');
}
---

<Page current="overview" title={data.title} description={data.description} terminal={terminal}>
  <div class="hero">
    <h1>{hero.headline}</h1>
    <p class="sub">{hero.sub}</p>

    {/* The locked block prints the commands and nothing else. Each `note` in
        the copy has no home in this design; what the landing page claims about
        installing is wayfinder ticket #62. */}
    <div class="installblock">{
        install.map(({ command }, n) => [
          <span class="p">$</span>,
          ' ',
          <span class="c">{command}</span>,
          n < install.length - 1 ? '\n' : '',
        ])
      }</div>

    <div class="split2">
      {
        panels.map((panel, n) => (
          <div class:list={['panel', { add: panel.accent }]}>
            <div class="hh">
              <span class="ix">{String(n + 1).padStart(2, '0')}</span>
              <b>{panel.title}</b>
              <span class="nt">{panel.note}</span>
            </div>
            {panel.rows.map((row) => (
              <div class="it">
                <h4>{row.title}</h4>
                <p>{row.body}</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <p class="outlink">
      {upstream.text} <a href={upstream.url}>{upstream.label}</a>.
    </p>
  </div>
</Page>
